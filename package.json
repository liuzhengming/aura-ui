{
  "name": "@zhengming365/aura-ui",
  "version": "0.1.0",
  "type": "module",
  "description": "Aura UI - a Vue 3 component library crafted for silky micro-interactions and modern motion. Zero runtime dependencies, fully typed, mobile-ready, dark by default.",
  "keywords": [
    "vue",
    "vue3",
    "ui",
    "animation",
    "micro-interaction",
    "components",
    "typescript",
    "component-library"
  ],
  "license": "MIT",
  "author": "liuzhengming",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/liuzhengming/aura-ui.git"
  },
  "homepage": "https://liuzhengming.github.io/aura-ui/",
  "bugs": {
    "url": "https://github.com/liuzhengming/aura-ui/issues"
  },
  "sideEffects": [
    "**/*.css"
  ],
  "main": "./dist/index.umd.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.umd.cjs"
    },
    "./style.css": "./dist/style.css",
    "./dist/style.css": "./dist/style.css"
  },
  "files": [
    "dist"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "build:lib": "vite build --config vite.lib.config.ts",
    "preview": "vite preview --host",
    "type-check": "vue-tsc --noEmit",
    "prepublishOnly": "npm run build:lib"
  },
  "peerDependencies": {
    "vue": "^3.4.0"
  },
  "devDependencies": {
    "@vitejs/plugin-vue": "^5.0.4",
    "typescript": "^5.4.5",
    "vite": "^5.2.10",
    "vite-plugin-dts": "^5.1.2",
    "vue": "^3.4.21",
    "vue-tsc": "^2.0.13"
  }
}
